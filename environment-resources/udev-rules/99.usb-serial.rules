# ICOM LINK — FTDI FT232R
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6001", ENV{ID_SERIAL_SHORT}=="A50285BI", SYMLINK+="ttyICOM-LINK", MODE="0660", GROUP="uucp"

# Yaesu FT-710 — CP2105, interface 0
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="10c4", ENV{ID_MODEL_ID}=="ea70", ENV{ID_SERIAL_SHORT}=="01A03F54", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="ttyFT710-0", MODE="0660", GROUP="uucp"

# Yaesu FT-710 — CP2105, interface 1
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="10c4", ENV{ID_MODEL_ID}=="ea70", ENV{ID_SERIAL_SHORT}=="01A03F54", ENV{ID_USB_INTERFACE_NUM}=="01", SYMLINK+="ttyFT710-1", MODE="0660", GROUP="uucp"